@using Microsoft.AspNetCore.Components
@using BookkeepingBlazor.Services

<div class="stats-root">
    @if (IsLoadingStats)
    {
        <div class="stats-loading">加载中...</div>
    }
    else if (!string.IsNullOrEmpty(LoadError))
    {
        <div class="stats-card stats-error-card">@LoadError</div>
    }
    else
    {
        <section class="stats-card stats-interval-card">
            <div class="stats-interval-grid">
                <div class="stats-interval-left">
                    <div class="stats-interval-label-line">统计区间：</div>
                    <div class="stats-interval-date-line">@FormatRangeLine()</div>
                </div>
                <div class="stats-interval-right">
                    <button type="button" class="stats-link-btn" @onclick="OpenRangePicker">更改范围</button>
                </div>
            </div>
        </section>

        <section class="stats-card stats-tabs-card">
            <div class="stats-seg-stack" role="presentation">
                <div class="stats-seg stats-seg-2" role="tablist" aria-label="统计方式">
                    <button type="button"
                            class="stats-seg-btn @(MethodTab == StatsMethodTab.Category ? "active" : "")"
                            @onclick="@(() => MethodTab = StatsMethodTab.Category)">类别统计</button>
                    <button type="button"
                            class="stats-seg-btn @(MethodTab == StatsMethodTab.Trend ? "active" : "")"
                            @onclick="@(() => MethodTab = StatsMethodTab.Trend)">月趋势图</button>
                </div>
                <div class="stats-seg stats-seg-3 stats-seg-row2" role="tablist" aria-label="统计对象">
                    <button type="button"
                            class="stats-seg-btn @(SelectedPersons.Contains(StatsPersonKind.Yiyi) ? "active" : "")"
                            @onclick="@(() => TogglePerson(StatsPersonKind.Yiyi))">依依</button>
                    <button type="button"
                            class="stats-seg-btn @(SelectedPersons.Contains(StatsPersonKind.Yiyi2) ? "active" : "")"
                            @onclick="@(() => TogglePerson(StatsPersonKind.Yiyi2))">一一</button>
                    <button type="button"
                            class="stats-seg-btn @(SelectedPersons.Contains(StatsPersonKind.Total) ? "active" : "")"
                            @onclick="@(() => TogglePerson(StatsPersonKind.Total))">共计</button>
                </div>
            </div>
        </section>

        @if (SelectedPersons.Count == 0)
        {
            <section class="stats-card stats-result-empty">
                <div class="stats-empty-msg">当前未选择统计对象</div>
            </section>
        }
        else if (!HasBillsInCurrentStatsRange())
        {
            <section class="stats-card stats-result-empty">
                <div class="stats-empty-msg">当前时间范围没有账单</div>
            </section>
        }
        else
        {
            <section class="stats-card stats-overview-card">
                <div class="stats-card-title">总览</div>
                @foreach (var p in OrderedSelectedPersons())
                {
                    var ov = GetOverview(p);
                    <div class="stats-sub-block">
                        <div class="stats-sub-title">@GetPersonTitle(p)</div>
                        <div class="stats-metric-grid">
                            <div>
                                <div class="stats-metric-label">总支出</div>
                                <div class="stats-metric-value expense">@Fmt(ov.Expense)</div>
                            </div>
                            <div>
                                <div class="stats-metric-label">总收入</div>
                                <div class="stats-metric-value income">@Fmt(ov.Income)</div>
                            </div>
                            <div>
                                <div class="stats-metric-label">结余</div>
                                <div class="stats-metric-value @BalanceClass(ov)">@Fmt(ov.Balance)</div>
                            </div>
                        </div>
                    </div>
                }
            </section>

            @if (MethodTab == StatsMethodTab.Category)
            {
                @foreach (var p in OrderedSelectedPersons())
                {
                    var cat = GetCategoryResult(p, CategoryIoExpense);
                    <section class="stats-card stats-detail-card@(!CategoryIoExpense ? " stats-cat-bars-income" : "")">
                        <div class="stats-detail-head">
                            <div class="stats-card-title stats-cat-section-title">
                                <span class="stats-cat-section-label">类别统计</span>　<span class="stats-cat-section-name">@GetPersonTitle(p)</span>
                            </div>
                            <label class="stats-io-switch">
                                <span class="@(CategoryIoExpense ? "on" : "")">支出</span>
                                <button type="button"
                                        class="stats-io-toggle @(CategoryIoExpense ? "expense" : "income")"
                                        @onclick="@(() => CategoryIoExpense = !CategoryIoExpense)"
                                        aria-label="切换支出或收入"></button>
                                <span class="@(!CategoryIoExpense ? "on" : "")">收入</span>
                            </label>
                        </div>
                        @if (cat.MainRows.Count == 0)
                        {
                            <div class="stats-muted">@(CategoryIoExpense ? "暂无支出数据" : "暂无收入数据")</div>
                        }
                        else
                        {
                            @foreach (var row in cat.MainRows)
                            {
                                <div class="stats-cat-block">
                                    <button type="button"
                                            class="stats-cat-head stats-cat-head-main"
                                            @onclick="@(() => ToggleCatExpand(row.MainCategoryId))">
                                        <span class="stats-cat-head-text">
                                            <span class="stats-cat-name-pct" title="@row.Name">@row.Name　@FormatPct(row.PctOfTotal)</span>
                                            <span class="stats-cat-amount">@Fmt(row.Amount)</span>
                                        </span>
                                    </button>
                                    <div class="stats-cat-bar-line" aria-hidden="true">
                                        <span class="stats-bar-line-track">
                                            <span class="stats-bar-line-fill" style="width:@(row.BarPct)%"></span>
                                        </span>
                                    </div>
                                    @if (IsCatExpanded(row.MainCategoryId))
                                    {
                                        <div class="stats-cat-sub-wrap">
                                            @foreach (var sub in row.SubRows)
                                            {
                                                <div class="stats-cat-sub-item">
                                                    <div class="stats-cat-head stats-cat-head-sub">
                                                        <span class="stats-cat-head-text">
                                                            <span class="stats-cat-name-pct" title="@sub.Name">@sub.Name　@FormatPct(sub.PctOfTotal)</span>
                                                            <span class="stats-cat-amount">@Fmt(sub.Amount)</span>
                                                        </span>
                                                    </div>
                                                    <div class="stats-cat-bar-line stats-cat-bar-line-sub" aria-hidden="true">
                                                        <span class="stats-bar-line-track stats-bar-line-track-sub">
                                                            <span class="stats-bar-line-fill" style="width:@(sub.BarPct)%"></span>
                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </section>
                }
            }
            else
            {
                @foreach (var (p, chartIdx) in OrderedSelectedPersonsIndexed())
                {
                    var pts = GetTrendPoints(p, TrendIoExpense);
                    var chart = BuildTrendChart(pts, StatsRangeStart, StatsRangeEnd, chartIdx);
                    <section class="stats-card stats-detail-card">
                        <div class="stats-detail-head">
                            <div class="stats-card-title stats-cat-section-title">
                                <span class="stats-cat-section-label">月趋势图</span>　<span class="stats-cat-section-name">@GetPersonTitle(p)</span>
                            </div>
                            <label class="stats-io-switch">
                                <span class="@(TrendIoExpense ? "on" : "")">支出</span>
                                <button type="button"
                                        class="stats-io-toggle @(TrendIoExpense ? "expense" : "income")"
                                        @onclick="@(() => { TrendIoExpense = !TrendIoExpense; ClearTrendSelection(); })"
                                        aria-label="切换支出或收入"></button>
                                <span class="@(!TrendIoExpense ? "on" : "")">收入</span>
                            </label>
                        </div>
                        <div class="stats-trend-chart">
                            <div class="stats-trend-y-rail" aria-hidden="true">
                                <div class="stats-trend-y-vals">
                                    <span>@chart.YTopLabel</span>
                                    <span>@chart.YMidLabel</span>
                                    <span>@chart.YBottomLabel</span>
                                </div>
                            </div>
                            <div class="stats-trend-scroll">
                                @if (chart.HasData)
                                {
                                    <svg class="stats-trend-svg"
                                         width="@chart.SvgWidth"
                                         height="@chart.SvgHeight"
                                         viewBox="@($"0 0 {chart.SvgWidth} {chart.SvgHeight}")"
                                         preserveAspectRatio="xMinYMid meet">
                                        @((MarkupString)chart.DefsMarkup)
                                        <line x1="@chart.OriginX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              y1="@chart.BaselineY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              x2="@chart.OriginX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              y2="@chart.YAxisTipY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              stroke="#94a3b8"
                                              class="stats-trend-axis-line"
                                              stroke-width="1.15"
                                              fill="none"
                                              marker-end="@($"url(#{chart.ArrowMarkerId})")" />
                                        <line x1="@chart.OriginX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              y1="@chart.BaselineY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              x2="@chart.XAxisTipX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              y2="@chart.BaselineY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                              stroke="#94a3b8"
                                              class="stats-trend-axis-line"
                                              stroke-width="1.15"
                                              fill="none"
                                              marker-end="@($"url(#{chart.ArrowMarkerId})")" />
                                        <polygon class="stats-trend-area" points="@chart.PolygonPoints" />
                                        <polyline fill="none"
                                                  stroke="#e65100"
                                                  class="stats-trend-stroke-line"
                                                  stroke-width="3"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  points="@chart.PolylinePoints" />
                                        @((MarkupString)chart.XLabelsMarkup)
                                        @for (var pi = 0; pi < chart.DataPoints.Count; pi++)
                                        {
                                            var dotIdx = pi;
                                            var d = chart.DataPoints[dotIdx];
                                            var sel = GetTrendSelection(chartIdx) == dotIdx;
                                            <circle role="button"
                                                    tabindex="0"
                                                    class="stats-trend-dot @(sel ? "selected" : "")"
                                                    cx="@d.Cx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    cy="@d.Cy.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    r="@(sel ? "4.5" : "3.5")"
                                                    @onclick="@(() => ToggleTrendPoint(chartIdx, dotIdx))"
                                                    @onkeydown="@(e => TrendDotKeydown(chartIdx, dotIdx, e))" />
                                        }
                                    </svg>
                                }
                                else
                                {
                                    <div class="stats-trend-empty">暂无数据</div>
                                }
                            </div>
                        </div>
                        @if (TryGetTrendSelectionDetail(chartIdx, chart, out var detail))
                        {
                            <div class="stats-trend-hint">@detail</div>
                        }
                        <div class="stats-chart-caption">@chart.Caption</div>
                    </section>
                }
            }
        }
    }
</div>

@if (ShowRangePicker)
{
    <div class="stats-picker-mask" @onclick="CloseRangePicker"></div>
    <div class="stats-picker-panel" @onclick:stopPropagation="true">
        <div class="stats-picker-title">选择统计区间</div>
        <div class="stats-seg stats-seg-2 stats-picker-tabs">
            <button type="button"
                    class="stats-seg-btn @(RangePickerMode == StatsRangePickerMode.Year ? "active" : "")"
                    @onclick="@(() => RangePickerMode = StatsRangePickerMode.Year)">按年度</button>
            <button type="button"
                    class="stats-seg-btn @(RangePickerMode == StatsRangePickerMode.Custom ? "active" : "")"
                    @onclick="@(() => RangePickerMode = StatsRangePickerMode.Custom)">自定义范围</button>
        </div>

        @if (RangePickerMode == StatsRangePickerMode.Year)
        {
            <div class="stats-year-stepper">
                <button type="button" class="stats-step-btn" @onclick="DecPickerYear" aria-label="上一年">−</button>
                <div class="stats-year-value">@PickerYear 年</div>
                <button type="button" class="stats-step-btn" @onclick="IncPickerYear" aria-label="下一年">＋</button>
            </div>
            <div class="stats-chip-row">
                <button type="button" class="stats-chip" @onclick="PickThisYear">今年</button>
                <button type="button" class="stats-chip" @onclick="PickLastYear">去年</button>
            </div>
        }
        else
        {
            <div class="stats-date-row">
                <span class="stats-date-label">开始</span>
                <InputDate @bind-Value="DraftCustomStart" />
            </div>
            <div class="stats-date-row">
                <span class="stats-date-label">结束</span>
                <InputDate @bind-Value="DraftCustomEnd" />
            </div>
            <div class="stats-chip-wrap">
                <button type="button" class="stats-chip" @onclick="PickThisMonthRange">本月</button>
                <button type="button" class="stats-chip" @onclick="PickLastMonthRange">上月</button>
                <button type="button" class="stats-chip" @onclick="PickLast7Days">最近7天</button>
                <button type="button" class="stats-chip" @onclick="PickLast30Days">最近30天</button>
                <button type="button" class="stats-chip" @onclick="PickAllRange">全部</button>
            </div>
        }

        <div class="stats-picker-preview">@FormatRangeLineDraft()</div>
        <div class="stats-picker-actions">
            <button type="button" class="stats-btn light" @onclick="CloseRangePicker">取消</button>
            <button type="button" class="stats-btn primary" @onclick="ConfirmRangePickerAsync">确定</button>
        </div>
    </div>
}
