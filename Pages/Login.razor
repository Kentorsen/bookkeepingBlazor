@page "/login"
@using BookkeepingBlazor.Services
@inject SupabaseService Supabase
@inject NavigationManager Nav

<div style="max-width: 400px; margin: 100px auto; padding: 24px; text-align: center; background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); font-family: sans-serif;">
    <h2 style="color: #27314a; margin-bottom: 8px;">记账本登录</h2>
    <p style="color: #8a93a7; font-size: 13px; margin-bottom: 24px;">为了安全，请输入邮箱获取验证码</p>
    
    @if (!IsCodeSent)
    {
        <input type="email" @bind="Email" @bind:event="oninput" @onblur="ValidateEmailWhitelistAsync" placeholder="输入邮箱地址"
               style="width: 100%; padding: 14px; margin-bottom: 16px; border: 1px solid #e8e8ee; border-radius: 10px; box-sizing: border-box; font-size: 15px; outline: none;" />
        @if (!string.IsNullOrWhiteSpace(Email))
        {
            <div style="margin-bottom: 12px; font-size: 12px; text-align: left;">
                @if (IsCheckingWhitelist)
                {
                    <span style="color:#8a93a7;">正在校验邮箱是否可登录...</span>
                }
                else if (IsWhitelistAllowed == true)
                {
                    <span style="color:#18a867;">该邮箱可以登录</span>
                }
                else if (IsWhitelistAllowed == false)
                {
                    <span style="color:#d63384;">该邮箱不在允许登录名单内</span>
                }
            </div>
        }
        
        <button @onclick="SendCode" disabled="@(IsLoading || IsCheckingWhitelist || IsWhitelistAllowed == false)"
                style="width: 100%; padding: 14px; background: #ef9cb8; color: white; border: none; border-radius: 10px; font-weight: bold; cursor: pointer; font-size: 15px;">
            @(IsLoading ? "发送中..." : "获取验证码")
        </button>
    }
    else
    {
        <p style="font-size: 13px; color: #18a867; margin-bottom: 16px; background: #e8f7f0; padding: 10px; border-radius: 8px;">
            ✅ 验证码已发送至 <b>@Email</b>
        </p>

        <input type="text" @bind="Code" placeholder="输入 8 位验证码" maxlength="8"
               style="width: 100%; padding: 14px; margin-bottom: 16px; border: 1px solid #84a4ff; border-radius: 10px; box-sizing: border-box; font-size: 18px; text-align: center; letter-spacing: 4px; outline: none;" />
        <div style="display:flex; justify-content:center; gap:16px; margin-bottom:16px; font-size:13px; color:#5f6677;">
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                <input type="radio" name="rememberDays" @onchange="() => RememberDays = 7" checked="@(RememberDays == 7)" />
                7天免验证
            </label>
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                <input type="radio" name="rememberDays" @onchange="() => RememberDays = 30" checked="@(RememberDays == 30)" />
                30天免验证
            </label>
        </div>

        <button @onclick="VerifyCode" disabled="@IsLoading"
                style="width: 100%; padding: 14px; background: #84a4ff; color: white; border: none; border-radius: 10px; font-weight: bold; cursor: pointer; font-size: 15px;">
            @(IsLoading ? "验证中..." : "确 认 登 录")
        </button>
        
        <button @onclick="ResetForm" style="margin-top: 16px; background: none; border: none; color: #8a93a7; font-size: 13px; cursor: pointer; text-decoration: underline;">
            修改邮箱
        </button>
    }

    @if (!string.IsNullOrEmpty(Message))
    {
        <div style="margin-top: 20px; padding: 12px; border-radius: 8px; background: #fdf2f5; color: #d63384; font-size: 13px;">
            @Message
        </div>
    }
</div>

@code {
    private string Email { get; set; } = "";
    private string Code { get; set; } = "";
    private string Message { get; set; } = "";
    private bool IsCodeSent = false;
    private bool IsLoading = false;
    private int RememberDays { get; set; } = 7;
    private bool IsCheckingWhitelist;
    private bool? IsWhitelistAllowed;
    private int EmailValidateVersion;
    private string LastAutoSentEmail = "";

    private async Task ValidateEmailWhitelistAsync()
    {
        var input = Email?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(input) || !input.Contains("@"))
        {
            IsWhitelistAllowed = null;
            IsCheckingWhitelist = false;
            return;
        }

        var version = ++EmailValidateVersion;
        IsCheckingWhitelist = true;
        try
        {
            var allowed = await Supabase.IsAllowedUserEmailAsync(input);
            if (version != EmailValidateVersion) return;
            IsWhitelistAllowed = allowed;
            if (allowed && !IsCodeSent && !IsLoading)
            {
                var latestInput = Email?.Trim() ?? "";
                if (string.Equals(latestInput, input, StringComparison.OrdinalIgnoreCase))
                {
                    await AutoSendCodeIfNeededAsync(input);
                }
            }
        }
        catch
        {
            if (version != EmailValidateVersion) return;
            IsWhitelistAllowed = null;
        }
        finally
        {
            if (version == EmailValidateVersion)
            {
                IsCheckingWhitelist = false;
            }
        }
    }

    private async Task SendCode()
    {
        if (string.IsNullOrWhiteSpace(Email) || !Email.Contains("@"))
        {
            Message = "请输入有效的邮箱地址";
            return;
        }
        
        IsLoading = true;
        Message = "";
        try
        {
            await ValidateEmailWhitelistAsync();
            if (IsWhitelistAllowed != true)
            {
                Message = "该邮箱不在允许登录名单内";
                return;
            }

            await Supabase.SendOtpAsync(Email);
            IsCodeSent = true;
            LastAutoSentEmail = Email.Trim();
        }
        catch (Exception ex)
        {
            Message = "❌ " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task VerifyCode()
    {
        if (string.IsNullOrWhiteSpace(Code))
        {
            Message = "请输入验证码";
            return;
        }

        IsLoading = true;
        Message = "";
        try
        {
            var token = await Supabase.VerifyOtpAsync(Email, Code, RememberDays);
            if (!string.IsNullOrEmpty(token))
            {
                // 验证成功，跳转到账单主页！
                Nav.NavigateTo("/bills");
            }
        }
        catch (Exception ex)
        {
            Message = "❌ " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ResetForm()
    {
        IsCodeSent = false;
        Code = "";
        Message = "";
        LastAutoSentEmail = "";
    }

    private async Task AutoSendCodeIfNeededAsync(string emailInput)
    {
        var normalized = emailInput.Trim();
        if (string.IsNullOrEmpty(normalized)) return;
        if (string.Equals(LastAutoSentEmail, normalized, StringComparison.OrdinalIgnoreCase)) return;

        IsLoading = true;
        Message = "";
        try
        {
            await Supabase.SendOtpAsync(normalized);
            IsCodeSent = true;
            LastAutoSentEmail = normalized;
        }
        catch (Exception ex)
        {
            Message = "❌ " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}